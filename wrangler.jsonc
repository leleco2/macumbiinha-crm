{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "macumbiinha-crm",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-05",
  "workers_dev": true,
  "vars": {
    "SITE_ORIGIN": "https://macumbiinha.pages.dev",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAF1Fas3oPq62j5rH"
  },
  "triggers": {
    "crons": [
      "0 3 * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "macumbiinha-crm-erp",
      "database_id": "4574df14-0b8a-4a1c-b8ca-fa659aa26c1f",
      "migrations_dir": "migrations"
    }
  ]
}
